# Copy to .env and edit. .env is git-ignored. Never put real credentials in this file.
# All variables are read by flowmerce.config.settings.

# Runtime environment: development | test | production
FLOWMERCE_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
FLOWMERCE_LOG_LEVEL=INFO

# =====================================================================
# SEO module (legacy blog-ops, flowmerce.modules.seo)
# =====================================================================
# --- Server ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
# Set APP_ENV=production behind HTTPS so session cookies are Secure.
APP_ENV=development
SESSION_HOURS=12
# First admin. Leave ADMIN_PASSWORD empty to have one generated into data/initial-admin.txt.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Safety switch --------------------------------------------------------
# Nothing can go live on a storefront until this is true, whatever any user clicks.
# Hidden Shopify drafts still work while it is false.
ALLOW_LIVE_PUBLISH=false

# --- Shopify (Admin API custom app: read_content, write_content, read_products) ---
SHOPIFY_API_VERSION=2025-10
RIDHI_SHOPIFY_SHOP=guz0he-21.myshopify.com
RIDHI_STOREFRONT_DOMAIN=ridhiblockprint.com
RIDHI_SHOPIFY_BLOG_HANDLE=news
RIDHI_SHOPIFY_ADMIN_TOKEN=
CPC_SHOPIFY_SHOP=liquidationfashion.myshopify.com
CPC_STOREFRONT_DOMAIN=cottonprintclub.com
CPC_SHOPIFY_BLOG_HANDLE=blogs
CPC_SHOPIFY_ADMIN_TOKEN=
# Without Admin tokens, live articles and products are read from each storefront's public feed.
PUBLIC_FEED_SYNC=true

# --- Google (one service account for Search Console + GA4) -----------------
# Absolute path to the service-account JSON key. Keep it outside this folder or in secrets/.
GOOGLE_SERVICE_ACCOUNT_FILE=
RIDHI_GSC_PROPERTY=sc-domain:ridhiblockprint.com
CPC_GSC_PROPERTY=sc-domain:cottonprintclub.com
# Numeric GA4 property IDs (Admin → Property details).
RIDHI_GA4_PROPERTY_ID=
CPC_GA4_PROPERTY_ID=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Server-side refusal fallbacks (beta). Set to false if your account rejects the parameter.
CLAUDE_FALLBACKS=true

# --- External agents ------------------------------------------------------
# Shared secret for POST /api/hooks/workflow (header X-Workflow-Secret).
WORKFLOW_WEBHOOK_SECRET=

# --- Background refresh -----------------------------------------------------
SCHEDULER=true
